# Copy this file to .env and replace the placeholders with cookies from an
# authenticated espn.com browser session. Keep the values quoted.
ESPN_S2="replace-with-your-espn_s2-cookie"
SWID="{replace-with-your-swid-cookie}"

# Configure one numbered block per fantasy team/league.
ESPN_LEAGUE_1_NAME="Team One"
ESPN_LEAGUE_1_ID="123456789"
ESPN_LEAGUE_1_TEAM_ID="1"

ESPN_LEAGUE_2_NAME="Team Two"
ESPN_LEAGUE_2_ID="234567890"
ESPN_LEAGUE_2_TEAM_ID="2"

ESPN_LEAGUE_3_NAME="Team Three"
ESPN_LEAGUE_3_ID="345678901"
ESPN_LEAGUE_3_TEAM_ID="3"
